# Never commit actual values. Copy to .env and load with your process manager.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_OWNER_ID=
TELEGRAM_GROUP_ID=
# Set true when IPv4 to Telegram is blocked but IPv6 works.
TELEGRAM_USE_IPV6=false
TOPIC_INCOMING=2
TOPIC_REMINDERS=3
TOPIC_STATS=4
TOPIC_IMPORTANT=5
FILTER_MODE=all
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=auto
